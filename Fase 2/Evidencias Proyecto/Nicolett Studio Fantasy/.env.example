SECRET_KEY=replace-with-a-local-secret-key
DEBUG=True

# Copy this file to .env and set local values. For Gmail, use an app password.
# Leave both SMTP credentials empty to print outgoing email to the runserver console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
