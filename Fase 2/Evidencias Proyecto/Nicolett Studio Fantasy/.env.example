SECRET_KEY=replace-with-a-local-secret-key
TRANSBANK_ENVIRONMENT=INTEGRATION
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_RETURN_URL=
DEBUG=True

# Copy this file to .env and set local values. Blank SMTP credentials use the
# console backend locally, which does not deliver email. For Gmail, use an app password.
# Account registration, activation confirmation, and password recovery require valid SMTP credentials.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=